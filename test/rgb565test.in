MD5_TESTORIG_GRAY_2X2_RGB565D_BMP=bdbbd616441a24354c98553df5dc82db
MD5_TESTORIG_GRAY_2X2_RGB565_BMP=12f78118e56a2f48b966f792fedf23cc

MD5_NARROW_YCC_2X2_RGB565D_BMP=16c1e2ef361a535d851c1f45f74b9f5b
MD5_NARROW_YCC_2X2_RGB565_BMP=9e6e81f1237887889505ceedcd9c751c
MD5_NARROW_YCC_2X2_RGB565_NOSIMD_BMP=9e6e81f1237887889505ceedcd9c751c
