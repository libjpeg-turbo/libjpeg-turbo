MD5_NARROW_GRAY_1X4_RGB565D_BMP=3b5320a2479ae01c311722d496bddeff
MD5_NARROW_GRAY_1X4_RGB565_BMP=f64ea0988227495e72c00ff56cc4f065

MD5_TESTORIG_YCC_2X2_RGB565D_BMP=ddee0dea2c21aa638d39f90ca9aaa57f
MD5_TESTORIG_YCC_2X2_RGB565_BMP=f20a145942fc9d5d772be517e6cce98c
MD5_TESTORIG_YCC_2X2_RGB565_NOSIMD_BMP=f20a145942fc9d5d772be517e6cce98c
