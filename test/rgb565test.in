MD5_NARROW_GRAY_2X2_RGB565D_BMP=3b5320a2479ae01c311722d496bddeff
MD5_NARROW_GRAY_2X2_RGB565_BMP=f64ea0988227495e72c00ff56cc4f065

compare()
{
	file=$1
	MD5=MD5_$(echo "$(basename $file)" | tr '[:lower:]' '[:upper:]')
	MD5=${MD5/\./_}
	MD5=${MD5//-/_}
	test/md5cmp ${!MD5} $file
}

dotest()
{
	for clr in ycc rgb gray; do
		BASENAME=${IMG}-${clr}-${samp}

		runme $EXEDIR/djpeg -rgb565 -nosmooth -bmp \
			-outfile $OUTDIR/$BASENAME-rgb565D.bmp $OUTDIR/$BASENAME.jpg
		magick $OUTDIR/$BASENAME-rgb565D.bmp $OUTDIR/$BASENAME-rgb565D-ref.ppm
		compare $OUTDIR/$BASENAME-rgb565D.bmp
		rm $OUTDIR/$BASENAME-rgb565D.bmp
		runme $EXEDIR/djpeg -rgb565 -nosmooth -bmp -dither none \
			-outfile $OUTDIR/$BASENAME-rgb565.bmp $OUTDIR/$BASENAME.jpg
		magick $OUTDIR/$BASENAME-rgb565.bmp $OUTDIR/$BASENAME-rgb565-ref.ppm
		compare $OUTDIR/$BASENAME-rgb565.bmp
		rm $OUTDIR/$BASENAME-rgb565.bmp
		if [ "$clr" = "ycc" ]; then
			JSIMD_FORCENONE=1 runme $EXEDIR/djpeg -rgb565 -nosmooth -bmp -dither none \
				-outfile $OUTDIR/$BASENAME-rgb565-nosimd.bmp $OUTDIR/$BASENAME.jpg
			compare $OUTDIR/$BASENAME-rgb565-nosimd.bmp
			rm $OUTDIR/$BASENAME-rgb565-nosimd.bmp
		fi
		echo

		runme $EXEDIR/djpeg -rgb565 -nosmooth \
			-outfile $OUTDIR/$BASENAME-rgb565D.ppm $OUTDIR/$BASENAME.jpg
		cmp $OUTDIR/$BASENAME-rgb565D.ppm $OUTDIR/$BASENAME-rgb565D-ref.ppm
		rm $OUTDIR/$BASENAME-rgb565D.ppm $OUTDIR/$BASENAME-rgb565D-ref.ppm
		runme $EXEDIR/djpeg -rgb565 -nosmooth -dither none \
			-outfile $OUTDIR/$BASENAME-rgb565.ppm $OUTDIR/$BASENAME.jpg
		cmp $OUTDIR/$BASENAME-rgb565.ppm $OUTDIR/$BASENAME-rgb565-ref.ppm
		rm $OUTDIR/$BASENAME-rgb565.ppm
		if [ "$clr" = "ycc" ]; then
			JSIMD_FORCENONE=1 runme $EXEDIR/djpeg -nosmooth -rgb565 -dither none \
				-outfile $OUTDIR/$BASENAME-rgb565-nosimd.ppm $OUTDIR/$BASENAME.jpg
			cmp $OUTDIR/$BASENAME-rgb565-nosimd.ppm $OUTDIR/$BASENAME-rgb565-ref.ppm
			rm $OUTDIR/$BASENAME-rgb565-nosimd.ppm
		fi
		rm $OUTDIR/$BASENAME-rgb565-ref.ppm $OUTDIR/$BASENAME.jpg
	echo
	done
}

for samp in 1x4 2x2; do

	echo "-------------------------------------------------------------------------------"
	echo "testorig (227x149) $samp subsampling"
	echo "-------------------------------------------------------------------------------"
	echo

	runme $EXEDIR/cjpeg -sample $samp \
		-outfile $OUTDIR/testorig-ycc-$samp.jpg $IMGDIR/testorig.ppm
	runme $EXEDIR/cjpeg -sample $samp -rgb \
		-outfile $OUTDIR/testorig-rgb-$samp.jpg $IMGDIR/testorig.ppm
	runme $EXEDIR/cjpeg -sample $samp -grayscale \
		-outfile $OUTDIR/testorig-gray-$samp.jpg $IMGDIR/testorig.ppm
	echo

	IMG=testorig
	dotest

	echo "-------------------------------------------------------------------------------"
	echo "narrow (1x8) $samp subsampling"
	echo "-------------------------------------------------------------------------------"
	echo

	echo "P3" > $OUTDIR/narrow.ppm
	echo "1 8" >> $OUTDIR/narrow.ppm
	echo "255" >> $OUTDIR/narrow.ppm
	echo "0 0 0" >> $OUTDIR/narrow.ppm
	echo "255 0 0" >> $OUTDIR/narrow.ppm
	echo "255 255 0" >> $OUTDIR/narrow.ppm
	echo "0 255 0" >> $OUTDIR/narrow.ppm
	echo "0 255 255" >> $OUTDIR/narrow.ppm
	echo "0 0 255" >> $OUTDIR/narrow.ppm
	echo "255 0 255" >> $OUTDIR/narrow.ppm
	echo "255 255 255" >> $OUTDIR/narrow.ppm

	runme $EXEDIR/cjpeg -sample $samp \
		-outfile $OUTDIR/narrow-ycc-$samp.jpg $OUTDIR/narrow.ppm
	runme $EXEDIR/cjpeg -sample $samp -rgb \
		-outfile $OUTDIR/narrow-rgb-$samp.jpg $OUTDIR/narrow.ppm
	runme $EXEDIR/cjpeg -sample $samp -grayscale \
		-outfile $OUTDIR/narrow-gray-$samp.jpg $OUTDIR/narrow.ppm
	rm $OUTDIR/narrow.ppm
	echo

	IMG=narrow
	dotest

done

echo GREAT SUCCESS!
