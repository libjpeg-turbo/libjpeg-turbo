#!/bin/bash

set -e
set -u
trap onexit INT
trap onexit TERM
trap onexit EXIT

onexit()
{
	if [ -d $OUTDIR ]; then
		rm -rf $OUTDIR
	fi
}

runme()
{
	echo \*\*\* $*
	$*
}

IMGDIR=@CMAKE_SOURCE_DIR@/testimages
OUTDIR=`mktemp -d /tmp/__rgb565test_output.XXXXXX`
EXEDIR=@CMAKE_BINARY_DIR@

if [ -d $OUTDIR ]; then
	rm -rf $OUTDIR
fi
mkdir -p $OUTDIR

exec >$EXEDIR/test/rgb565test.log 2>&1

MD5_TESTORIG_YCC_1X4_RGB565D_BMP=05d9d66a052df0f4d43b315eb1e1a287
MD5_TESTORIG_YCC_1X4_RGB565_BMP=3034dd4eb24255943011363d8ed0ed5d
MD5_TESTORIG_YCC_1X4_RGB565_NOSIMD_BMP=3034dd4eb24255943011363d8ed0ed5d
MD5_TESTORIG_RGB_1X4_RGB565D_BMP=0b0278840fab52bd300f1589e2e06bf5
MD5_TESTORIG_RGB_1X4_RGB565_BMP=1d47efa4a2a17aa4643870bcace511dc
MD5_TESTORIG_GRAY_1X4_RGB565D_BMP=bdbbd616441a24354c98553df5dc82db
MD5_TESTORIG_GRAY_1X4_RGB565_BMP=12f78118e56a2f48b966f792fedf23cc

